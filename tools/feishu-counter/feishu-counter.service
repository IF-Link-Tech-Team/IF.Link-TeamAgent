[Unit]
Description=IFLink TeamAgent Feishu API request counter (local TLS proxy)
Documentation=file:%h/TeamAgent/dsh-superagent/tools/feishu-counter/README.md
After=network-online.target

[Service]
Type=simple
ExecStart=%h/TeamAgent/dsh-superagent/tools/feishu-counter/counter.py --port 18080 --role-port 18081=orchestrator --role-port 18082=worker --role-port 18083=dreaming
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# 代理只读自己的状态目录、只听回环；它替 lark-cli 终止 TLS，本身不需要任何特权。
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.dsh/feishu-counter

[Install]
WantedBy=default.target
